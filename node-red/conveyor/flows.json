    {
        "id": "539caa671566b953",
        "type": "function",
        "z": "5cd55ca858fd3527",
        "name": "encode speed set point",
        "func": "\nconst speed = Number(msg.payload);\n\nif (!Number.isFinite(speed) || speed < 0 || speed > 1.33) {\n    node.warn(\"Speed setpoint must be between 0 and 1.33\");\n    return null;\n}\n\n// Encode IEEE-754 REAL as two 16-bit registers,\n// high word first, matching the OpenPLC mapping.\nconst buf = Buffer.alloc(4);\nbuf.writeFloatBE(speed, 0);\n\nconst highWord = buf.readUInt16BE(0);\nconst lowWord = buf.readUInt16BE(2);\n\nmsg.payload = {\n    value: [highWord, lowWord],\n    fc: 16,\n    unitid: 1,\n    address: 42,\n    quantity: 2\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
