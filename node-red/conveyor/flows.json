    {
        "id": "9c303d5686a0dce7",
        "type": "function",
        "z": "ea087883fe7f4ebf",
        "name": "Decode speed",
        "func": "\nconst regs = msg.payload;\n\nif (!Array.isArray(regs) || regs.length < 2) {\n    node.warn(\"Expected two Modbus registers\");\n    return null;\n}\n\nconst buf = Buffer.alloc(4);\nbuf.writeUInt16BE(regs[0], 0);\nbuf.writeUInt16BE(regs[1], 2);\n\nmsg.payload = buf.readFloatBE(0);\nmsg.topic = \"speed_test_decoded\";\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
