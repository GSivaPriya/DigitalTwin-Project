    {
        "id": "08487d425b14441a",
        "type": "function",
        "z": "5cd55ca858fd3527",
        "name": "function 3",
        "func": "const topicMap = {\n    \"factory/conveyor/01/commands/start\": 0,\n    \"factory/conveyor/01/commands/stop\": 1,\n    \"factory/conveyor/01/commands/forward\": 2,\n    \"factory/conveyor/01/commands/reverse\": 3,\n    \"factory/conveyor/01/sensors/entry\": 4,\n    \"factory/conveyor/01/sensors/exit\": 5\n};\n\nconst address = topicMap[msg.topic];\n\nif (address === undefined) {\n    return null;\n}\n\nconst value = typeof msg.payload === \"string\"\n    ? msg.payload.toLowerCase() === \"true\"\n    : Boolean(msg.payload);\n\nmsg.payload = {\n    value: value,\n    fc: 5,\n    unitid: 1,\n    address: address,\n    quantity: 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
