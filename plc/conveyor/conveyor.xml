            </variable>
            <variable name="ReverseCommand" address="%MX0.3">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="FALSE"/>
              </initialValue>
              <documentation>
                <xhtml:p><![CDATA[Command requesting reverse conveyor movement]]></xhtml:p>
              </documentation>
            </variable>
            <variable name="EntrySensor" address="%MX0.4">
              <type>
                <BOOL/>
              </type>
