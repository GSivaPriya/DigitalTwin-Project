            <variable name="MotorRun" address="%MX0.6">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="FALSE"/>
              </initialValue>
              <documentation>
                <xhtml:p><![CDATA[PLC-controlled motor run state]]></xhtml:p>
              </documentation>
            </variable>
            <variable name="MotorDirection" address="%MW0">
              <type>
                <INT/>
              </type>
              <initialValue>
                <simpleValue value="0"/>
              </initialValue>
              <documentation>
                <xhtml:p><![CDATA[PLC motor direction: 1=Forward, -1=Reverse, 0=Stopped]]></xhtml:p>
              </documentation>
            </variable>
            <variable name="BoxCount" address="%MW1">
              <type>
                <INT/>
              </type>
              <initialValue>
                <simpleValue value="0"/>
              </initialValue>
              <documentation>
                <xhtml:p><![CDATA[Number of boxes counted by the PLC from EntrySensor rising edges]]></xhtml:p>
              </documentation>
            </variable>
            <variable name="PreviousEntrySensor">
              <type>
                <BOOL/>
              </type>
              <initialValue>
                <simpleValue value="FALSE"/>
              </initialValue>
              <documentation>
                <xhtml:p><![CDATA[Internal memory of EntrySensor from the previous PLC scan]]></xhtml:p>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[(* =========================================================
       MOTOR CONTROL
       ========================================================= *)

    (* Stop has highest priority *)
    IF StopCommand THEN
        MotorRun := FALSE;

    (* Start only if exactly one direction is selected *)
    (*ELSIF StartCommand AND (ForwardCommand XOR ReverseCommand) THEN
        MotorRun := TRUE;
    END_IF;*)

    ELSIF StartCommand THEN
        MotorRun := TRUE;
    END_IF;

    (* =========================================================
       MOTOR DIRECTION
       
       1  = Forward
       -1 = Reverse
       0  = No direction
       ========================================================= *)

    (* Conflicting direction commands *)
    (*IF ForwardCommand AND ReverseCommand THEN
        MotorRun := FALSE;
        MotorDirection := 0;*)

    (*ELSIF ForwardCommand THEN
        MotorDirection := 1;

    ELSIF ReverseCommand THEN
        MotorDirection := -1;
    END_IF;*)


    (* =========================================================
       BOX COUNTING
       
       Count only when EntrySensor changes:
       FALSE -> TRUE
       ========================================================= *)

    IF EntrySensor AND NOT PreviousEntrySensor THEN
        BoxCount := BoxCount + 1;
    END_IF;


    (* Remember EntrySensor state for the next PLC scan *)
    PreviousEntrySensor := EntrySensor;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p><![CDATA[ ]]></xhtml:p>
        </documentation>
